# ============ 必填配置 ============
# LLM API Key（DeepSeek或其他OpenAI兼容接口）
LLM_API_KEY=sk-xxxxx
# 飞书应用凭证
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx
# 飞书多维表格 Token（从飞书多维表格URL中获取）
FEISHU_BITABLE_APP_TOKEN=

# ============ 可选配置（有默认值）============
# LLM设置
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096

# 飞书Webhook验证（仅webhook模式需要）
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# 飞书多维表格 Table ID（运行 python -m max_system init 后自动填入）
# BITABLE_TABLE_CLIENTS=
# BITABLE_TABLE_CONTRACTS=
# BITABLE_TABLE_SUPPLIERS=
# BITABLE_TABLE_EXPENSE=
# BITABLE_TABLE_INCOME=
# BITABLE_TABLE_CONSTRUCTION=
# BITABLE_TABLE_TASKS=
# BITABLE_TABLE_AFTER_SALES=
# BITABLE_TABLE_FOLLOWUPS=

# 路径（留空=项目根目录下自动创建）
# KNOWLEDGE_BASE_PATH=
# QUOTE_DATA_PATH=
